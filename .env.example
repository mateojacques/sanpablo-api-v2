# =====================================================
# SAN PABLO API - Environment Variables
# =====================================================
# Copy this file to .env and fill in the values

# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://sanpablo:sanpablo@localhost:5432/sanpablo

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# S3
S3_BUCKET=sanpablo-assets

# SQS
# For LocalStack 3.x, use the full URL format with subdomain:
SQS_IMPORT_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/sanpablo-import

# =====================================================
# SMTP Configuration (Google Workspace)
# =====================================================
# To use Gmail/Google Workspace SMTP, you need an App Password:
#
# 1. Go to your Google Account: https://myaccount.google.com
# 2. Navigate to: Security > 2-Step Verification (must be enabled)
# 3. At the bottom, click "App passwords"
# 4. Select "Mail" and your device, then click "Generate"
# 5. Copy the 16-character password (without spaces) to SMTP_PASS
#
# Note: App passwords only work with accounts that have 2-Step Verification enabled

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@tudominio.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_EMAIL=pedidos@tudominio.com

# Store Configuration
OWNER_EMAIL=owner@example.com
OWNER_WHATSAPP=+5491155551234

# Rate Limiting (optional)
REDIS_URL=redis://localhost:6379
